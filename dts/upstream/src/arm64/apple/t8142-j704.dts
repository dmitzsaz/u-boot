// SPDX-License-Identifier: GPL-2.0-only OR MIT
/dts-v1/;

/* Static J704 topology. Aura supplies current-boot memory, OPPs and firmware
 * properties; the owner supplies HAL300 power inputs in a private overlay. */
/ {
	compatible = "apple,j704", "apple,t8142", "apple,arm-platform";
	model = "Apple MacBook Pro (14-inch, M5, J704)";
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	interrupt-parent = <&aic>;

	ext-display-subsystem {
		iommus = <&soc_iommu_3aa300000 0x0>;
		apple,j704-mapping-handoff = <0x01>;
		compatible = "apple,t8142-ext-display-subsystem";
		status = "disabled";
	};

	opp_table_pcluster: opp-table-pcluster {
		opp-shared;
		compatible = "operating-points-v2";
	};

	opp_table_ecluster: opp-table-ecluster {
		opp-shared;
		compatible = "operating-points-v2";
	};

	display_subsystem: display-subsystem {
		iommus = <&soc_iommu_286300000 0x0>;
		apple,j704-mapping-handoff = <0x01>;
		compatible = "apple,t8142-display-subsystem", "apple,display-subsystem";
		status = "disabled";
	};

	opp_table_agx: opp-table-agx {
		compatible = "operating-points-v2";
	};

	aliases {
		atcphy2 = "/soc/phy@413000000";
		usb0 = "/soc/usb@402280000";
		atcphy0 = "/soc/phy@403000000";
		serial0 = "/soc/serial@3a5200000";
		mtp = "/soc/mtp@394600000";
		keyboard = "/soc/fifo@394b14000/input@8000/keyboard";
		atcphy1 = "/soc/phy@40b000000";
		usb1 = "/soc/usb@40a280000";
		atcphy3 = "/soc/phy@41b000000";
		usb3 = "/soc/usb@41a280000";
		gpu = "/soc/gpu@582600000";
		nvme = &nvme;
		ans-mailbox = &ans_mbox;
		ans-sart = &ans_sart;
		pmp = "/soc/pmp@380500000";
		dcp = "/soc/dcp@286e00000";
		disp0 = "/display-subsystem";
		disp0_piodma = &soc_dcp_286e00000_piodma;
		dcpext1 = "/soc/dcp@3aae00000";
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0:115200n8";

		framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0x00 0x00 0x00 0x00>;
			status = "disabled";
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
	};

	memory@10000000000 {
		device_type = "memory";
		reg = <0 0 0 0>;
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu-map {

			cluster1 {

				core3 {
					cpu = <&cpus_cpu_10103>;
				};

				core2 {
					cpu = <&cpus_cpu_10102>;
				};

				core1 {
					cpu = <&cpus_cpu_10101>;
				};

				core0 {
					cpu = <&cpus_cpu_10100>;
				};
			};

			cluster0 {

				core5 {
					cpu = <&cpus_cpu_5>;
				};

				core4 {
					cpu = <&cpus_cpu_4>;
				};

				core3 {
					cpu = <&cpus_cpu_3>;
				};

				core2 {
					cpu = <&cpus_cpu_2>;
				};

				core1 {
					cpu = <&cpus_cpu_1>;
				};

				core0 {
					cpu = <&cpus_cpu_0>;
				};
			};
		};

		cpus_cpu_0: cpu@0 {
			capacity-dmips-mhz = <0x217>;
			performance-domains = <&soc_cpufreq_210e20000>;
			operating-points-v2 = <&opp_table_ecluster>;
			compatible = "apple,t8142-e";
			device_type = "cpu";
			reg = <0x00 0x00>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
		};

		cpus_cpu_1: cpu@1 {
			capacity-dmips-mhz = <0x217>;
			performance-domains = <&soc_cpufreq_210e20000>;
			operating-points-v2 = <&opp_table_ecluster>;
			compatible = "apple,t8142-e";
			device_type = "cpu";
			reg = <0x00 0x01>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
		};

		cpus_cpu_2: cpu@2 {
			capacity-dmips-mhz = <0x217>;
			performance-domains = <&soc_cpufreq_210e20000>;
			operating-points-v2 = <&opp_table_ecluster>;
			compatible = "apple,t8142-e";
			device_type = "cpu";
			reg = <0x00 0x02>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
		};

		cpus_cpu_3: cpu@3 {
			capacity-dmips-mhz = <0x217>;
			performance-domains = <&soc_cpufreq_210e20000>;
			operating-points-v2 = <&opp_table_ecluster>;
			compatible = "apple,t8142-e";
			device_type = "cpu";
			reg = <0x00 0x03>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
		};

		cpus_cpu_4: cpu@4 {
			capacity-dmips-mhz = <0x217>;
			performance-domains = <&soc_cpufreq_210e20000>;
			operating-points-v2 = <&opp_table_ecluster>;
			compatible = "apple,t8142-e";
			device_type = "cpu";
			reg = <0x00 0x04>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
		};

		cpus_cpu_5: cpu@5 {
			capacity-dmips-mhz = <0x217>;
			performance-domains = <&soc_cpufreq_210e20000>;
			operating-points-v2 = <&opp_table_ecluster>;
			compatible = "apple,t8142-e";
			device_type = "cpu";
			reg = <0x00 0x05>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
		};

		cpus_cpu_10100: cpu@10100 {
			capacity-dmips-mhz = <0x400>;
			performance-domains = <&soc_cpufreq_211e20000>;
			operating-points-v2 = <&opp_table_pcluster>;
			compatible = "apple,t8142-p";
			device_type = "cpu";
			reg = <0x00 0x10100>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
		};

		cpus_cpu_10101: cpu@10101 {
			capacity-dmips-mhz = <0x400>;
			performance-domains = <&soc_cpufreq_211e20000>;
			operating-points-v2 = <&opp_table_pcluster>;
			compatible = "apple,t8142-p";
			device_type = "cpu";
			reg = <0x00 0x10101>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
		};

		cpus_cpu_10102: cpu@10102 {
			capacity-dmips-mhz = <0x400>;
			performance-domains = <&soc_cpufreq_211e20000>;
			operating-points-v2 = <&opp_table_pcluster>;
			compatible = "apple,t8142-p";
			device_type = "cpu";
			reg = <0x00 0x10102>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
		};

		cpus_cpu_10103: cpu@10103 {
			capacity-dmips-mhz = <0x400>;
			performance-domains = <&soc_cpufreq_211e20000>;
			operating-points-v2 = <&opp_table_pcluster>;
			compatible = "apple,t8142-p";
			device_type = "cpu";
			reg = <0x00 0x10103>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x02 0x04 0x01 0x03 0x04 0x01 0x00 0x04 0x01 0x01 0x04>;
		interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
	};

	clock_ref: clock-ref {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		nonposted-mmio;

		soc_crossbar_41304c000: crossbar@41304c000 {
			power-domains = <&soc_power_management_388280000_power_controller_f0>;
			#mux-control-cells = <0x01>;
			reg = <0x04 0x1304c000 0x00 0x4000>;
			compatible = "apple,t8142-display-crossbar";
		};

		soc_phy_413000000: phy@413000000 {
			power-domains = <&soc_power_management_380700000_power_controller_2d8>;
			mode-switch;
			orientation-switch;
			#reset-cells = <0x00>;
			#phy-cells = <0x01>;
			reg-names = "core", "lpdptx", "axi2af";
			reg = <0x04 0x13000000 0x00 0x4c000 0x04 0x13050000 0x00 0x8000 0x04 0x10000000 0x00 0x8000>;
			compatible = "apple,t8142-atcphy";

			ports {
				#size-cells = <0x00>;
				#address-cells = <0x01>;

				port@2 {
					reg = <0x02>;

					soc_phy_413000000_ports_port_2_endpoint: endpoint {
						remote-endpoint = <&soc_dcp_3aae00000_ports_port_1_endpoint>;
					};
				};
			};
		};

		soc_pinctrl_39a000000: pinctrl@39a000000 {
			interrupts = <0x00 0x15b 0x04 0x00 0x15c 0x04 0x00 0x15d 0x04 0x00 0x15e 0x04 0x00 0x15f 0x04 0x00 0x160 0x04 0x00 0x161 0x04>;
			interrupt-parent = <&aic>;
			#interrupt-cells = <0x02>;
			interrupt-controller;
			gpio-reserved-ranges = <0x88 0x01 0x89 0x01 0xa3 0x01 0x4e 0x01 0xcb 0x01>;
			apple,npins = <0xe0>;
			gpio-ranges = <&soc_pinctrl_39a000000 0x0 0x0 0xe0>;
			#gpio-cells = <0x02>;
			gpio-controller;
			power-domains = <&soc_power_management_380700000_power_controller_120>;
			reg = <0x03 0x9a000000 0x00 0x100000>;
			compatible = "apple,t8142-pinctrl";
		};

		soc_dcp_3aae00000: dcp@3aae00000 {
			apple,pmp-report = <&j704_pmp_atc2>;
			#address-cells = <2>;
			#size-cells = <2>;
			dp2hdmi-pwren-gpios = <&soc_smc_38c600000_gpio 0x1a 0x0>;
			hdmi-pwren-gpios = <&soc_smc_38c600000_gpio 0xf 0x0>;
			hdmi-hpd-gpios = <&soc_pinctrl_39a000000 0x29 0x0>;
			apple,dptx-phy = <0x02>;
			mux-index = <0x04>;
			clocks = <&clock_ref>;
			apple,iomfb-surfaces = <0x00 0x00 0x01 0x00>;
			apple,bw-doorbell = <&soc_power_management_382730000 0x1 0x6>;
			apple,bw-scratch = <&soc_power_management_382730000 0x0 0x5 0x0>;
			reg = <0x03 0xaae00000 0x00 0x4000 0x03 0xa8000000 0x00 0xb1c000 0x03 0xaa240000 0x00 0x10000 0x03 0xaa3ac000 0x00 0x4000 0x03 0xaa800000 0x00 0x800000 0x03 0x82700000 0x00 0x114000 0x03 0xaa850000 0x00 0x4000>;
			reg-names = "coproc", "disp-0", "disp-1", "disp-2", "disp-3", "disp-4", "iop-vbar";
			apple,typec-dptx-phys = <0x03 0x00 0x01>;
			apple,typec-mux-indices = <0x04 0x04 0x04>;
			mux-control-names = "typec0", "typec1", "typec2", "dp-xbar";
			mux-controls = <&soc_crossbar_41b04c000 0x0 &soc_crossbar_40304c000 0x0 &soc_crossbar_40b04c000 0x0 &soc_crossbar_41304c000 0x0>;
			phy-names = "typec0", "typec1", "typec2", "dp-phy";
			phys = <&soc_phy_41b000000 0x6 &soc_phy_403000000 0x6 &soc_phy_40b000000 0x6 &soc_phy_413000000 0x6>;
			iommus = <&soc_iommu_3aa340000 0x17>;
			mbox-names = "mbox";
			mboxes = <&soc_mailbox_3aae08000>;
			apple,connector-type = "HDMI-A";
			apple,j704-mapping-handoff = <0x01>;
			apple,j704-dcp-sdk = "27.0";
			compatible = "apple,t8142-dcpext-v27";
			status = "disabled";

			ports {
				#size-cells = <0x00>;
				#address-cells = <0x01>;

				port@1 {
					reg = <0x01>;

					soc_dcp_3aae00000_ports_port_1_endpoint: endpoint {
						remote-endpoint = <&soc_phy_413000000_ports_port_2_endpoint>;
					};
				};
			};

			typec-routes {
				#size-cells = <0x00>;
				#address-cells = <0x01>;

				route@2 {
					mode-switch;
					reg = <0x02>;

					port {

						soc_dcp_3aae00000_typec_routes_route_2_port_endpoint: endpoint {
							remote-endpoint = <&soc_spmi_388908000_usb_pd_a_connector_ports_port_3_endpoint>;
						};
					};
				};

				route@1 {
					mode-switch;
					reg = <0x01>;

					port {

						soc_dcp_3aae00000_typec_routes_route_1_port_endpoint: endpoint {
							remote-endpoint = <&soc_spmi_388908000_usb_pd_c_connector_ports_port_3_endpoint>;
						};
					};
				};

				route@0 {
					mode-switch;
					reg = <0x00>;

					port {

						soc_dcp_3aae00000_typec_routes_route_0_port_endpoint: endpoint {
							remote-endpoint = <&soc_spmi_388a08000_usb_pd_c_connector_ports_port_3_endpoint>;
						};
					};
				};
			};

			piodma {
				apple,j704-mapping-handoff = <0x01>;
				iommus = <&soc_iommu_3aa300000 0x10>;
			};
		};

		soc_crossbar_40b04c000: crossbar@40b04c000 {
			#mux-control-cells = <0x01>;
			reg = <0x04 0xb04c000 0x00 0x4000>;
			compatible = "apple,t8142-display-crossbar";
		};

		soc_crossbar_40304c000: crossbar@40304c000 {
			#mux-control-cells = <0x01>;
			reg = <0x04 0x304c000 0x00 0x4000>;
			compatible = "apple,t8142-display-crossbar";
		};

		soc_crossbar_41b04c000: crossbar@41b04c000 {
			#mux-control-cells = <0x01>;
			reg = <0x04 0x1b04c000 0x00 0x4000>;
			compatible = "apple,t8142-display-crossbar";
		};

		soc_iommu_3aa340000: iommu@3aa340000 {
			apple,dma-range = <0x100 0x00 0x10 0x00>;
			#iommu-cells = <0x01>;
			interrupts = <0x00 0x3b3 0x04>;
			interrupt-parent = <&aic>;
			reg = <0x03 0xaa340000 0x00 0x20000>;
			compatible = "apple,t8142-dart", "apple,t8110-dart";
		};

		soc_iommu_3aa300000: iommu@3aa300000 {
			apple,dma-range = <0x100 0x00 0x10 0x00>;
			#iommu-cells = <0x01>;
			interrupts = <0x00 0x3b3 0x04>;
			interrupt-parent = <&aic>;
			reg = <0x03 0xaa300000 0x00 0xc000>;
			compatible = "apple,t8142-dart", "apple,t8110-dart";
		};

		soc_mailbox_3aae08000: mailbox@3aae08000 {
			#mbox-cells = <0x00>;
			interrupt-names = "send-empty", "send-not-empty", "recv-empty", "recv-not-empty";
			interrupts = <0x00 0x39d 0x04 0x00 0x39e 0x04 0x00 0x39f 0x04 0x00 0x3a0 0x04>;
			interrupt-parent = <&aic>;
			reg = <0x03 0xaae08000 0x00 0x4000>;
			compatible = "apple,t8142-asc-mailbox", "apple,asc-mailbox-v4";
		};

		ans_mbox: mailbox@481608000 {
			compatible = "apple,t8142-asc-mailbox", "apple,asc-mailbox-v4";
			reg = <0x4 0x81608000 0 0x4000>;
			interrupt-parent = <&aic>;
			interrupts = <0 1143 4>, <0 1144 4>, <0 1145 4>, <0 1146 4>;
			interrupt-names = "send-empty", "send-not-empty",
					  "recv-empty", "recv-not-empty";
			#mbox-cells = <0>;
			power-domains = <&ps_ans>;
			status = "disabled";
		};

		ans_sart: sart@485c50000 {
			compatible = "apple,t8142-sart", "apple,t6000-sart";
			reg = <0x4 0x85c50000 0 0xc000>;
			power-domains = <&ps_ans>;
			status = "disabled";
		};

		nvme: nvme@4c5cc0000 {
			compatible = "apple,t8142-nvme-ans2";
			reg = <0x4 0xc5cc0000 0 0x10000>,
			      <0x4 0x81600000 0 0x4000>,
			      <0x4 0x85cc0000 0 0x60000>;
			reg-names = "nvme", "ans", "nvmmu";
			interrupt-parent = <&aic>;
			interrupts = <0 1155 4>;
			mboxes = <&ans_mbox>;
			apple,sart = <&ans_sart>;
			apple,pmp-report = <&j704_pmp_ans>;
			power-domains = <&ps_ans>, <&ps_apcie_sys_st>, <&ps_apcie_phy_sw>;
			power-domain-names = "ans", "apcie0", "apcie_phy";
			status = "disabled";
		};

		soc_power_management_382730000: power-management@382730000 {
			#apple,bw-doorbell-cells = <0x02>;
			#apple,bw-scratch-cells = <0x03>;
			reg-names = "dcp-bw-scratch", "dcp-bw-doorbell";
			reg = <0x03 0x82730000 0x00 0x08 0x03 0x827b4000 0x00 0x04>;
		};

		pmp-report@3803c0000 {
			#size-cells = <0x00>;
			#address-cells = <0x01>;
			apple,pmp = <&soc_pmp_380500000>;
			power-domains = <&soc_power_management_380700000_power_controller_5a0>;
			reg = <0x03 0x803c0000 0x00 0x14000>;
			apple,j704-start-at-probe;
			compatible = "apple,t8142-pmp-v2-report";
			status = "disabled";

			j704_pmp_atc2: report@1f {
				apple,always-on;
				apple,soc-device-record;
				#power-domain-cells = <0x00>;
				label = "pmp-atc2";
				reg = <0x1f>;
				compatible = "apple,t8142-pmp-v2-report-entry";
			};

			j704_pmp_ans: report@21 {
				apple,no-ack;
				apple,always-on;
				apple,soc-device-record;
				#power-domain-cells = <0x00>;
				label = "pmp-ans";
				reg = <0x21>;
				compatible = "apple,t8142-pmp-v2-report-entry";
			};

			report@20 {
				apple,always-on;
				apple,soc-device-record;
				#power-domain-cells = <0x00>;
				label = "pmp-atc3";
				reg = <0x20>;
				compatible = "apple,t8142-pmp-v2-report-entry";
			};

			report@1e {
				apple,always-on;
				apple,soc-device-record;
				#power-domain-cells = <0x00>;
				label = "pmp-atc1";
				reg = <0x1e>;
				compatible = "apple,t8142-pmp-v2-report-entry";
			};

			report@1d {
				apple,always-on;
				apple,soc-device-record;
				#power-domain-cells = <0x00>;
				label = "pmp-atc0";
				reg = <0x1d>;
				compatible = "apple,t8142-pmp-v2-report-entry";
			};

			report@4 {
				apple,always-on;
				apple,soc-device-record;
				#power-domain-cells = <0x00>;
				label = "pmp-gfx";
				reg = <0x04>;
				compatible = "apple,t8142-pmp-v2-report-entry";
			};

			report@9 {
				apple,defer-startup-ack;
				apple,always-on;
				apple,soc-device-record;
				#power-domain-cells = <0x00>;
				label = "pmp-dispext1";
				reg = <0x09>;
				compatible = "apple,t8142-pmp-v2-report-entry";
			};

			report@7 {
				apple,always-on;
				apple,soc-device-record;
				#power-domain-cells = <0x00>;
				label = "pmp-disp";
				reg = <0x07>;
				compatible = "apple,t8142-pmp-v2-report-entry";
			};
		};

		soc_pmp_380500000: pmp@380500000 {
			status = "disabled";
			apple,dma-range = <0x100 0x00 0x10 0x00>;
			apple,pmc-max-bwr-latency-us = <0xf4240>;
			apple,pmc-pmgr = <0x1f>;
			apple,pmc = <0x01>;
			power-domains = <&soc_power_management_380700000_power_controller_598>;
			iommus = <&soc_iommu_380300000 0x0>;
			mbox-names = "mbox";
			mboxes = <&soc_mailbox_380e08000>;
			reg-names = "pmp", "asc";
			reg = <0x03 0x80500000 0x00 0xd0000 0x03 0x80e00000 0x00 0x4000>;
			compatible = "apple,t8142-pmp-v2", "apple,t6000-pmp-v2";
		};

		soc_mailbox_380e08000: mailbox@380e08000 {
			status = "disabled";
			power-domains = <&soc_power_management_380700000_power_controller_598>;
			#mbox-cells = <0x00>;
			interrupt-names = "send-empty", "send-not-empty", "recv-empty", "recv-not-empty";
			interrupts = <0x00 0x3e8 0x04 0x00 0x3e9 0x04 0x00 0x3ea 0x04 0x00 0x3eb 0x04>;
			interrupt-parent = <&aic>;
			reg = <0x03 0x80e08000 0x00 0x4000>;
			compatible = "apple,t8142-asc-mailbox", "apple,asc-mailbox-v4";
		};

		soc_iommu_380300000: iommu@380300000 {
			status = "disabled";
			power-domains = <&soc_power_management_380700000_power_controller_598>;
			#iommu-cells = <0x01>;
			interrupts = <0x00 0x3ec 0x04>;
			interrupt-parent = <&aic>;
			reg = <0x03 0x80300000 0x00 0xc000>;
