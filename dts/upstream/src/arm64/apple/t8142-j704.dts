			soc_power_management_388280000_power_controller_c8: power-controller@c8 {
				apple,always-on;
				label = "atc0-usb-aon";
				#reset-cells = <0x00>;
				#power-domain-cells = <0x00>;
				reg = <0xc8 0x04>;
				compatible = "apple,t8142-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
			};

			soc_power_management_388280000_power_controller_70: power-controller@70 {
				compatible = "apple,t8142-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x70 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "nub-spmi-a0";
			};

			soc_power_management_388280000_power_controller_d8: power-controller@d8 {
				compatible = "apple,t8142-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0xd8 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "atc1-usb-aon";
			};

			soc_power_management_388280000_power_controller_e0: power-controller@e0 {
				compatible = "apple,t8142-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0xe0 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				power-domains = <&soc_power_management_380700000_power_controller_2d0 &soc_power_management_388280000_power_controller_d8>;
				label = "atc1-usb";
			};

			soc_power_management_388280000_power_controller_78: power-controller@78 {
				compatible = "apple,t8142-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x78 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "nub-spmi-a1";
			};

			soc_power_management_388280000_power_controller_f8: power-controller@f8 {
				compatible = "apple,t8142-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0xf8 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "atc3-usb-aon";
			};

			soc_power_management_388280000_power_controller_100: power-controller@100 {
				compatible = "apple,t8142-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				reg = <0x100 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				power-domains = <&soc_power_management_380700000_power_controller_2e0 &soc_power_management_388280000_power_controller_f8>;
				label = "atc3-usb";
			};
		};

		spmi@388908000 {
			compatible = "apple,t8142-spmi";
			reg = <0x03 0x88908000 0x00 0x4000>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			power-domains = <&soc_power_management_388280000_power_controller_70>;

			usb-pd@c {
				reg = <0x0c 0x00>;
				compatible = "apple,sn201202x";

				connector {
					data-role = "host";
					power-role = "dual";
					label = "USB-C Left-front";
					compatible = "usb-c-connector";

					ports {
						#size-cells = <0x00>;
						#address-cells = <0x01>;

						port@3 {
							reg = <0x03>;

							soc_spmi_388908000_usb_pd_c_connector_ports_port_3_endpoint: endpoint {
								remote-endpoint = <&soc_dcp_3aae00000_typec_routes_route_1_port_endpoint>;
							};
						};

						port@1 {
							reg = <0x01>;

							soc_spmi_388908000_usb_pd_c_connector_ports_port_1_endpoint: endpoint {
								remote-endpoint = <&soc_phy_403000000_ports_port_0_endpoint>;
							};
						};

						port@0 {
							reg = <0x00>;

							soc_spmi_388908000_usb_pd_c_connector_ports_port_0_endpoint: endpoint {
								remote-endpoint = <&soc_usb_402280000_ports_port_0_endpoint>;
							};
						};
					};
				};
			};

			usb-pd@a {
				compatible = "apple,sn201202x";
				reg = <0x0a 0x00>;

				connector {
					compatible = "usb-c-connector";
					label = "USB-C Left-rear (MagSafe side)";
					power-role = "dual";
					data-role = "host";

					ports {
						#address-cells = <0x01>;
						#size-cells = <0x00>;

						port@3 {
							reg = <0x03>;

							soc_spmi_388908000_usb_pd_a_connector_ports_port_3_endpoint: endpoint {
								remote-endpoint = <&soc_dcp_3aae00000_typec_routes_route_2_port_endpoint>;
							};
						};

						port@0 {
							reg = <0x00>;

							soc_spmi_388908000_usb_pd_a_connector_ports_port_0_endpoint: endpoint {
								remote-endpoint = <&soc_usb_40a280000_ports_port_0_endpoint>;
							};
						};

						port@1 {
							reg = <0x01>;

							soc_spmi_388908000_usb_pd_a_connector_ports_port_1_endpoint: endpoint {
								remote-endpoint = <&soc_phy_40b000000_ports_port_0_endpoint>;
							};
						};
					};
				};
			};
		};

		usb@40a280000 {
			compatible = "apple,t8142-dwc3", "apple,t8103-dwc3";
			reg = <0x04 0xa280000 0x00 0xcd00 0x04 0xa28cd00 0x00 0x4b00>;
			reg-names = "dwc3-core", "dwc3-apple";
			interrupts = <0x00 0x626 0x04>;
			dr_mode = "host";
			maximum-speed = "super-speed-plus";
			usb-role-switch;
			role-switch-default-mode = "host";
			iommus = <&soc_iommu_40af00000 0x0 &soc_iommu_40af80000 0x1>;
			power-domains = <&soc_power_management_388280000_power_controller_e0>;
			resets = <&soc_phy_40b000000>;
			phys = <&soc_phy_40b000000 0x3 &soc_phy_40b000000 0x4>;
			phy-names = "usb2-phy", "usb3-phy";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					soc_usb_40a280000_ports_port_0_endpoint: endpoint {
						remote-endpoint = <&soc_spmi_388908000_usb_pd_a_connector_ports_port_0_endpoint>;
					};
				};

				port@1 {
					reg = <0x01>;

					soc_usb_40a280000_ports_port_1_endpoint: endpoint {
						remote-endpoint = <&soc_phy_40b000000_ports_port_1_endpoint>;
					};
				};
			};
		};

		soc_iommu_40af00000: iommu@40af00000 {
			compatible = "apple,t8142-dart", "apple,t8110-dart";
			reg = <0x04 0xaf00000 0x00 0xc000>;
			interrupts = <0x00 0x62a 0x04>;
			power-domains = <&soc_power_management_388280000_power_controller_e0>;
			#iommu-cells = <0x01>;
			apple,dma-range = <0x100 0x4000 0x00 0xffff0000>;
		};

		soc_iommu_40af80000: iommu@40af80000 {
			compatible = "apple,t8142-dart", "apple,t8110-dart";
			reg = <0x04 0xaf80000 0x00 0xc000>;
			interrupts = <0x00 0x62a 0x04>;
			power-domains = <&soc_power_management_388280000_power_controller_e0>;
			#iommu-cells = <0x01>;
			apple,dma-range = <0x100 0x4000 0x00 0xffff0000>;
		};

		soc_phy_40b000000: phy@40b000000 {
			compatible = "apple,t8142-atcphy";
			reg = <0x04 0xb000000 0x00 0x4c000 0x04 0xb050000 0x00 0x8000 0x04 0x8000000 0x00 0x8000 0x04 0xaa90000 0x00 0x4000 0x04 0xaa84000 0x00 0x4000>;
			reg-names = "core", "lpdptx", "axi2af", "usb2phy", "pipehandler";
			#phy-cells = <0x01>;
			#reset-cells = <0x00>;
			orientation-switch;
			mode-switch;
			power-domains = <&soc_power_management_388280000_power_controller_e0>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					soc_phy_40b000000_ports_port_0_endpoint: endpoint {
						remote-endpoint = <&soc_spmi_388908000_usb_pd_a_connector_ports_port_1_endpoint>;
					};
				};

				port@1 {
					reg = <0x01>;

					soc_phy_40b000000_ports_port_1_endpoint: endpoint {
						remote-endpoint = <&soc_usb_40a280000_ports_port_1_endpoint>;
					};
				};
			};
		};

		spmi@388a08000 {
			compatible = "apple,t8142-spmi";
			reg = <0x03 0x88a08000 0x00 0x4000>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			power-domains = <&soc_power_management_388280000_power_controller_78>;

			usb-pd@c {
				compatible = "apple,sn201202x";
				reg = <0x0c 0x00>;

				connector {
					compatible = "usb-c-connector";
					label = "USB-C Right";
					power-role = "dual";
					data-role = "host";

					ports {
						#address-cells = <0x01>;
						#size-cells = <0x00>;

						port@3 {
							reg = <0x03>;

							soc_spmi_388a08000_usb_pd_c_connector_ports_port_3_endpoint: endpoint {
								remote-endpoint = <&soc_dcp_3aae00000_typec_routes_route_0_port_endpoint>;
							};
						};

						port@0 {
							reg = <0x00>;

							soc_spmi_388a08000_usb_pd_c_connector_ports_port_0_endpoint: endpoint {
								remote-endpoint = <&soc_usb_41a280000_ports_port_0_endpoint>;
							};
						};

						port@1 {
							reg = <0x01>;

							soc_spmi_388a08000_usb_pd_c_connector_ports_port_1_endpoint: endpoint {
								remote-endpoint = <&soc_phy_41b000000_ports_port_0_endpoint>;
							};
						};
					};
				};
			};
		};

		usb@41a280000 {
			compatible = "apple,t8142-dwc3", "apple,t8103-dwc3";
			reg = <0x04 0x1a280000 0x00 0xcd00 0x04 0x1a28cd00 0x00 0x4b00>;
			reg-names = "dwc3-core", "dwc3-apple";
			interrupts = <0x00 0x6a4 0x04>;
			dr_mode = "host";
			maximum-speed = "super-speed-plus";
			usb-role-switch;
			role-switch-default-mode = "host";
			iommus = <&soc_iommu_41af00000 0x0 &soc_iommu_41af80000 0x1>;
			power-domains = <&soc_power_management_388280000_power_controller_100>;
			resets = <&soc_phy_41b000000>;
			phys = <&soc_phy_41b000000 0x3 &soc_phy_41b000000 0x4>;
			phy-names = "usb2-phy", "usb3-phy";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					soc_usb_41a280000_ports_port_0_endpoint: endpoint {
						remote-endpoint = <&soc_spmi_388a08000_usb_pd_c_connector_ports_port_0_endpoint>;
					};
				};

				port@1 {
					reg = <0x01>;

					soc_usb_41a280000_ports_port_1_endpoint: endpoint {
						remote-endpoint = <&soc_phy_41b000000_ports_port_1_endpoint>;
					};
				};
			};
		};

		soc_iommu_41af00000: iommu@41af00000 {
			compatible = "apple,t8142-dart", "apple,t8110-dart";
			reg = <0x04 0x1af00000 0x00 0xc000>;
			interrupts = <0x00 0x6a8 0x04>;
			power-domains = <&soc_power_management_388280000_power_controller_100>;
			#iommu-cells = <0x01>;
			apple,dma-range = <0x100 0x4000 0x00 0xffff0000>;
		};

		soc_iommu_41af80000: iommu@41af80000 {
			compatible = "apple,t8142-dart", "apple,t8110-dart";
			reg = <0x04 0x1af80000 0x00 0xc000>;
			interrupts = <0x00 0x6a8 0x04>;
			power-domains = <&soc_power_management_388280000_power_controller_100>;
			#iommu-cells = <0x01>;
			apple,dma-range = <0x100 0x4000 0x00 0xffff0000>;
		};

		soc_phy_41b000000: phy@41b000000 {
			compatible = "apple,t8142-atcphy";
			reg = <0x04 0x1b000000 0x00 0x4c000 0x04 0x1b050000 0x00 0x8000 0x04 0x18000000 0x00 0x8000 0x04 0x1aa90000 0x00 0x4000 0x04 0x1aa84000 0x00 0x4000>;
			reg-names = "core", "lpdptx", "axi2af", "usb2phy", "pipehandler";
			#phy-cells = <0x01>;
			#reset-cells = <0x00>;
			orientation-switch;
			mode-switch;
			power-domains = <&soc_power_management_388280000_power_controller_100>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					soc_phy_41b000000_ports_port_0_endpoint: endpoint {
						remote-endpoint = <&soc_spmi_388a08000_usb_pd_c_connector_ports_port_1_endpoint>;
					};
				};

				port@1 {
					reg = <0x01>;

					soc_phy_41b000000_ports_port_1_endpoint: endpoint {
						remote-endpoint = <&soc_usb_41a280000_ports_port_1_endpoint>;
					};
				};
			};
		};

		soc_mailbox_38c608000: mailbox@38c608000 {
			compatible = "apple,t8142-asc-mailbox", "apple,asc-mailbox-v4";
			reg = <0x03 0x8c608000 0x00 0x4000>;
			interrupts = <0x00 0x279 0x04 0x00 0x27a 0x04 0x00 0x27b 0x04 0x00 0x27c 0x04>;
			interrupt-names = "send-empty", "send-not-empty", "recv-empty", "recv-not-empty";
			#mbox-cells = <0x00>;
		};

		smc: smc@38c600000 {
			compatible = "apple,t8142-smc", "apple,t8103-smc";
			reg = <0x03 0x8c600000 0x00 0x4000 0x03 0x8de00000 0x00 0x120000>;
			reg-names = "smc", "sram";
			mboxes = <&soc_mailbox_38c608000>;

			reboot {
				status = "okay";
				compatible = "apple,smc-reboot";
			};

			soc_smc_38c600000_gpio: gpio {
				compatible = "apple,smc-gpio";
				gpio-controller;
				#gpio-cells = <0x02>;
			};
		};
	};
};

